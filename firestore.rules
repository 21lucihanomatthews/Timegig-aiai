rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == '21lucihanomatthews@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get, list: if isSignedIn() && (
        isAdmin() || 
        isOwner(userId) || 
        resource.data.referredBy == request.auth.uid
      );
      
      allow create: if isOwner(userId);
      
      allow update: if isAdmin() 
        || isOwner(userId)
        || (
          isSignedIn() 
          && resource.data.referredBy == request.auth.uid 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'verificationStatus', 'rejectionReason', 'subscriptionPlan', 'subscriptionEnd', 'referralVerified', 'updatedAt'
          ])
        );
    }
    
    // --- Payments Collection ---
    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }
  }
}

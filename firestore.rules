rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Validation ---
    function isValidUser(data) {
      let requiredFields = ['uid', 'email', 'firstName', 'surname', 'createdAt', 'updatedAt'];
      let optionalFields = [
        'dateOfBirth', 'contactNumber', 'location', 'socialLinks', 
        'profilePictureUrl', 'idDocumentUrl', 'termsAccepted', 'termsAcceptedAt',
        'subscriptionPlan', 'subscriptionType', 'isActive', 'updatedAtServer',
        'trades', 'experience', 'references', 'referredBy'
      ];
      
      return data.keys().hasAll(requiredFields)
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.firstName is string && data.firstName.size() >= 1
        && data.surname is string && data.surname.size() >= 1;
    }

    function isTenant() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionPlan == 'tenant';
    }

    // --- Collections ---
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == '21lucihanomatthews@gmail.com';
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && (
        isAdmin() || 
        isOwner(userId) || 
        resource.data.referredBy == request.auth.uid
      );
      
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      
      allow update: if isAdmin() || (isOwner(userId) && isValidUser(incoming()))
        || (isSignedIn() && resource.data.referredBy == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['verificationStatus', 'rejectionReason', 'updatedAt']));
    }
    
    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }
  }
}
